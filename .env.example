# Copy to .env for running the scripts on your own computer. In the cloud the same values are GitHub secrets.
# Never commit the real values.

GEMINI_API_KEY=
# the bot account on Kalorické tabulky (plain e-mail + password, not Google login)
KT_EMAIL=
KT_PASSWORD=
# e-mails of everyone who should receive the lunch, comma-separated; each must be a connected person of the bot account
KT_SEND_TO=

# optional
# NTFY_TOPIC=            long random topic name for phone notifications through the ntfy app
# VAPID_PRIVATE_KEY=     only for the browser-notification fallback (see docs/phone-notifications-guide.md)
# CUTOFF_HOUR=20         hour of the day when the estimate is sent for a day without a photo
# GEMINI_MODEL=          first model to try, overrides the default list
